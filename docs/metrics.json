    "methodology": [
      {
        "title": "Financial cohort",
        "body": "Exact duplicates are removed. The analysis requires finite values, positive adjusted budget and revenue, and positive runtime. Excluded observations remain counted in the coverage audit."
      },
      {
        "title": "Sensitivity and uncertainty",
        "body": "Each cohort has 1,000 fixed-seed paired-record bootstrap draws for Spearman correlation. Whiskers show the 95% percentile interval. Filters are recomputed before resampling."
      },
      {
        "title": "Decision boundary",
        "body": "This is descriptive research, not a pre-release revenue forecast. Audience measures may be observed after release. Revenue is not profit; missing costs and selective financial reporting limit commercial inference."
      }
    ],
    "notes": "The public report contains aggregate statistics only. Movie-level records and text are not embedded."
  },
